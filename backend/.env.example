# Copia este fichero a .env (ignorado por git). NUNCA subas el .env real.

# development: /docs activo y secreto JWT aleatorio si falta. production: secretos obligatorios, sin /docs y con HSTS.
APP_ENV=development

# Secreto con el que se firman las sesiones (JWT). Obligatorio en producción, mínimo 32 caracteres.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
# Vida de los enlaces enviados por correo (confirmar email, restablecer contraseña).
VERIFY_LINK_HOURS=48
RESET_LINK_MINUTES=30
# Dirección pública del frontend: los correos llevan enlaces a ella. En producción debe ser https://
APP_BASE_URL=http://localhost:4200

# Correo saliente. «console» (solo desarrollo) escribe el correo en el log; en producción usa smtp.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# false para cerrar el registro de cuentas nuevas (lanzamiento por invitación).
REGISTRATION_OPEN=true

# Clave de la API de Claude (obligatoria en producción: la búsqueda de ofertas la usa).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Búsqueda de ofertas. Modelo, topes de gasto por búsqueda y cupo mensual por plan.
SEARCH_MODEL=claude-sonnet-5-5
SEARCH_MAX_TOKENS=16000
SEARCH_MAX_WEB_SEARCHES=20
SEARCH_MAX_WEB_FETCHES=20
# Freno de coste global: búsquedas aceptadas en 24 h entre todos los usuarios. Al superarlo, 503 para todos.
MAX_SEARCHES_PER_DAY=200
FREE_SEARCHES_PER_MONTH=1
PRO_SEARCHES_PER_MONTH=30

DATABASE_URL=sqlite:///./job_tracker.db
CORS_ORIGINS=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1

# true solo si hay un proxy inverso de confianza delante (nginx): entonces se usa X-Forwarded-For.
TRUST_PROXY=false

# Límites por IP y minuto, y tamaño máximo del cuerpo de una petición (bytes).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_MINUTE=6
RATE_LIMIT_AUTH_PER_MINUTE=10
# Bloqueo temporal de una cuenta tras N inicios de sesión fallidos en la ventana (además del límite por IP).
LOGIN_FAILURES_PER_WINDOW=10
LOGIN_WINDOW_MINUTES=15
MAX_BODY_BYTES=1048576

LEGACY_EXCEL_PATH=../Ofertas_Maria_Reyes.xlsx
CV_OUTPUT_DIR=../CV_adaptados
