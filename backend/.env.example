# Copia este fichero a .env (ignorado por git). NUNCA subas el .env real.

# development: API abierta si no hay token y /docs activo. production: token obligatorio, sin /docs y con HSTS.
APP_ENV=development

# Token de acceso (Authorization: Bearer ...). Obligatorio en producción, mínimo 32 caracteres.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

DATABASE_URL=sqlite:///./job_tracker.db
CORS_ORIGINS=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1

# true solo si hay un proxy inverso de confianza delante (nginx): entonces se usa X-Forwarded-For.
TRUST_PROXY=false

# Límites por IP y minuto, y tamaño máximo del cuerpo de una petición (bytes).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_MINUTE=6
MAX_BODY_BYTES=1048576

LEGACY_EXCEL_PATH=../Ofertas_Maria_Reyes.xlsx
CV_OUTPUT_DIR=../CV_adaptados
